{
  "name": "aliproxy",
  "version": "2026.4.0",
  "description": "Aliproxy 2026 — Ultimate Proxy Suite: DashScope/Qwen API key management, model group routing, metrics, and an OpenAI-compatible proxy server.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3456",
    "build": "next build",
    "start": "next start -p 3456",
    "lint": "next lint",
    "proxy": "tsx watch server/index.ts",
    "proxy:build": "tsc -p tsconfig.server.json",
    "proxy:import": "tsx server/scripts/import-keys.ts",
    "proxy:seed": "tsx server/scripts/seed-defaults.ts",
    "proxy:seed-farm": "tsx server/scripts/seed-farm.ts",
    "proxy:create-groups": "tsx server/scripts/create-custom-groups.ts",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-select": "2.1.1",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.0",
    "@radix-ui/react-tabs": "1.1.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "hono": "^4.13.5",
    "lucide-react": "0.436.0",
    "next": "^14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.2",
    "tailwindcss-animate": "1.0.7",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "tsx": "^4.23.13",
    "typescript": "5.5.4",
    "vitest": "^4.1.11"
  }
}
